# A股量化分析助手 — 环境变量模板
# 复制此文件为 .env 并填入真实值

# Tushare Token（必填 — https://tushare.pro 注册获取）
TUSHARE_TOKEN=your_tushare_token_here

# JWT 密钥（必填 — 随机字符串，生产环境务必修改）
JWT_SECRET_KEY=generate_a_random_secret_here_min_32_chars

# 调试模式（生产环境务必设为 false）
DEBUG=false

# CORS 允许的域名（生产环境改为你的前端域名，逗号分隔）
CORS_ORIGINS=*
